SECRET_KEY=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DB_NAME=dbname
DB_USER=dbuser
DB_PASS=pass
POSTGRES_DB=dbname
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=pass
GUNICORN_WORKERS=3

# Сетевые настройки - те же имена и правила, что в Метрологии.
# 1 - разработка (CORS для всех источников), 0 - прод.
DJANGO_DEBUG=0

# localhost, 127.0.0.1, web-app и боевой домен ueip-s-is02.ueip.ru
# подставляются автоматически, даже если их здесь нет.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web-app,ueip-s-is02.ueip.ru

# Источники всех хостов из DJANGO_ALLOWED_HOSTS (http и https) добавляются
# сами, здесь указывают только дополнительные.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://ueip-s-is02.ueip.ru
CORS_ALLOWED_ORIGINS=http://localhost,https://ueip-s-is02.ueip.ru

# Порт, который видит браузер (пусто для 80/443).
PUBLIC_PORT=

# 1 - стенд работает по https (secure-cookie). Для локального запуска
# по http поставьте 0, иначе вход в админку не сохранится.
DJANGO_HTTPS_ONLY=1
