FROM node:20-alpine AS frontend

WORKDIR /app

COPY envirotrack/frontend/package*.json ./
RUN npm ci --no-audit --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

COPY envirotrack/frontend/ ./

ENV GENERATE_SOURCEMAP=false \
    CI=true

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=frontend /app/build /app/frontend/build
